# Copy to .env and fill in. Never commit .env.
# Hugging Face token with write access (model publishing, Spaces deploy)
HF_TOKEN=
# Copernicus Data Space Ecosystem credentials (free: https://dataspace.copernicus.eu)
CDSE_USER=
CDSE_PASS=

# --- YOLO MVP Detector (Optional) ---
# Set to enable YOLO mode (absolute path to best.pt)
OILSPILL_API_YOLO_WEIGHTS=C:\path\to\best.pt
OILSPILL_API_YOLO_CONF_THRESHOLD=0.25
OILSPILL_API_YOLO_IOU_THRESHOLD=0.45
